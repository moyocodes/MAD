# SEO & Security: basic rules
# Enable URL rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect to canonical host (www.mindfullyarticulated.com)
  RewriteCond %{HTTP_HOST} !^www\.mindfullyarticulated\.com$ [NC]
  RewriteRule ^ https://www.mindfullyarticulated.com%{REQUEST_URI} [L,R=301]

  # Force HTTPS (only applies if host already correct)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^www\.mindfullyarticulated\.com$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect requests with .html to extensionless canonical URL
  RewriteCond %{THE_REQUEST} \s/([^\s]+?)\.html[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Internally rewrite extensionless URLs to .html files if present
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Remove index.html from URL
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Prevent directory listings
Options -Indexes

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json
</IfModule>

# Block common sensitive files (including vercel.json)
<FilesMatch "(^\.|vercel\.json|package-lock\.json|yarn\.lock)">
  Require all denied
</FilesMatch>
