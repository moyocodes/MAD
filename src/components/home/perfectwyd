                  "linear-gradient(#000 1px,transparent 1px),linear-gradient(90deg,#000 1px,transparent 1px)",
                backgroundSize: "24px 24px",
                pointerEvents: "none",
                zIndex: 0,
              }}
            />
          )}

          {/* Top label chip */}
          <div
            style={{
              position: "absolute",
              top: 0,
              left: 0,
              right: 0,
              zIndex: 20,
              padding: "14px 16px 32px",
              background:
                "linear-gradient(to bottom,rgba(255,255,255,.9) 0%,transparent 100%)",
