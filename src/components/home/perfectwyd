// ── SimCard — neutral with depth stack ────────────────────────────────────────
function SimCard({ card, isActive }) {
  const [stage, setStage] = useState(2); // start from RESULT
  const fillRef = useRef(null);
  const rafRef = useRef(null);
  const startTsRef = useRef(null);

  const runCycle = useCallback(() => {
    const pf = fillRef.current;
    if (!pf) return;
    pf.style.transition = "none";
    pf.style.width = "0%";
    setStage(0);
    startTsRef.current = null;
    const tick = (ts) => {
      if (!startTsRef.current) startTsRef.current = ts;
      const elapsed = ts - startTsRef.current;
      pf.style.width = `${Math.min(100, (elapsed / TOTAL_DUR) * 100)}%`;
      if (elapsed >= S1_DUR + S2_DUR)
        setStage(0); // request last
      else if (elapsed >= S1_DUR)
        setStage(1); // processing middle
      else setStage(2); // result first
      if (elapsed < TOTAL_DUR) rafRef.current = requestAnimationFrame(tick);
      else setTimeout(runCycle, LOOP_PAUSE);
    };
    rafRef.current = requestAnimationFrame(tick);
  }, []);

  useEffect(() => {
    injectBlink();
    runCycle();
    return () => cancelAnimationFrame(rafRef.current);
  }, [runCycle]);

  return (
    <div
      style={{
        width: 360,
        minWidth: 360,
        flexShrink: 0,
        display: "flex",
        flexDirection: "column",
        gap: 14,
      }}
    >
      {/* ── Depth stack wrapper ── */}
      <div
        style={{ position: "relative", paddingBottom: 10, paddingRight: 10 }}
      >
        {/* Card 3 — deepest shadow card */}
        <div
          style={{
            position: "absolute",
            top: 12,
            left: 12,
            right: 0,
            bottom: 0,
            height: 440,
            borderRadius: 22,
            background: N[200],
            zIndex: 0,
          }}
        />
        {/* Card 2 — mid card */}
        <div
          style={{
            position: "absolute",
            top: 6,
            left: 6,
            right: -6,
            bottom: -6,
            height: 440,
            borderRadius: 22,
            background: N[100],
            border: "1px solid #e0e0e0",
            zIndex: 1,
          }}
        />

        {/* ── Main card ── */}
        <div
          style={{
            position: "relative",
            zIndex: 2,
            width: "100%",
            height: 440,
            borderRadius: 22,
            overflow: "hidden",
            background: N[50],
            border: "1px solid #e0e0e0",
            boxShadow: isActive
              ? "0 12px 40px rgba(0,0,0,.14), 0 2px 8px rgba(0,0,0,.06)"
