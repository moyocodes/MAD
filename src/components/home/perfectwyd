// ── ServicesInMotion ──────────────────────────────────────────────────────────
function ServicesInMotion({ dark, scrollProgress, simOpacity }) {
  const CARD_W = 360;
  const CARD_GAP = 28;
  const VISIBLE = 3.2;
  const STEP = CARD_W + CARD_GAP;

  const simProgress = Math.min(1, Math.max(0, (scrollProgress - 0.52) / 0.48));
  const maxScroll = (SIM_CARDS.length - VISIBLE) * STEP;
  const translateX = -(simProgress * maxScroll);
  const activeIndex = Math.round(
    simProgress / (1 / (SIM_CARDS.length - Math.floor(VISIBLE))),
  );

  // Text colors adapt to the dark bg transition
  const eyebrowColor = simOpacity > 0.5 ? "rgba(255,255,255,.3)" : "#8a9ab0";
  const headingColor = simOpacity > 0.5 ? "#f0ede8" : "#0a0f1e";
  const arrowColor = simOpacity > 0.5 ? "#ccc" : "#555";
  const arrowBorder =
    simOpacity > 0.5 ? "rgba(255,255,255,.15)" : "rgba(0,0,0,.14)";
  const dotActive =
    simOpacity > 0.5 ? "rgba(255,255,255,.75)" : "rgba(10,22,40,.65)";
  const dotInactive =
    simOpacity > 0.5 ? "rgba(255,255,255,.18)" : "rgba(10,22,40,.16)";

  return (
    <div
      style={{
        display: "flex",
        flexDirection: "column",
        height: "100%",
        overflow: "hidden",
      }}
    >
      {/* Header */}
      <div
        style={{
          padding: "90px 48px 40px",
          display: "flex",
          alignItems: "flex-end",
          justifyContent: "space-between",
          flexShrink: 0,
        }}
      >
        <div>
          <p
            style={{
              margin: "0 0 8px",
              fontFamily: F.mono,
              fontSize: 10,
              letterSpacing: ".22em",
              textTransform: "uppercase",
              color: eyebrowColor,
              transition: "color .3s",
            }}
          >
            Services in motion &nbsp;·&nbsp; scroll to explore
          </p>
          <h2
            style={{
              margin: 0,
              fontFamily: F.serif,
              fontStyle: "italic",
              fontWeight: 400,
              fontSize: "clamp(28px,3vw,38px)",
              color: headingColor,
              lineHeight: 1.05,
              transition: "color .3s",
            }}
          >
            Systems for growth.
          </h2>
        </div>
        <div style={{ display: "flex", gap: 8 }}>
          {[
            { d: "M14 6L8 12l6 6", label: "Previous" },
            { d: "M10 6l6 6-6 6", label: "Next" },
          ].map(({ d, label }, i) => (
            <button
              key={i}
