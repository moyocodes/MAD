                viewBox="0 0 24 24"
                fill="none"
                stroke={arrowColor}
                strokeWidth="2"
                strokeLinecap="round"
              >
                <path d={d} />
              </svg>
            </button>
          ))}
        </div>
      </div>

      {/* Card strip */}
      <div style={{ flex: 1, overflow: "hidden", paddingLeft: 48 }}>
        <div
          style={{
            display: "flex",
